# Dependencies
node_modules

# Build output
dist

# Uploaded files (keep the directory, ignore its contents)
uploads/*
!uploads/.gitkeep

# Environment (never commit real secrets)
.env
.env.*.local

# Ad-hoc data dumps: one-off backups and import sheets taken before a bulk
# change. They hold real student names and fee records — never commit them.
_*.json
_*.tsv
_*.csv
_*.pdf

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
